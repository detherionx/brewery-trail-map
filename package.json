{
  "name": "brewery-trail-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:push": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/.bin/drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "import:trail": "tsx --env-file-if-exists=.env.local scripts/import-trail-geometry.ts",
    "refresh:google": "tsx --env-file-if-exists=.env.local scripts/refresh-google-data.ts"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@xmldom/xmldom": "^0.9.11",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.21.0"
}
