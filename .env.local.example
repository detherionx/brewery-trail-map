# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Google Maps JavaScript API key (exposed to the browser — restrict it to your
# domain(s) in the Google Cloud Console: APIs & Services > Credentials).
# Required APIs: "Maps JavaScript API"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID required for AdvancedMarkerElement (create one under Google Cloud Console >
# Google Maps Platform > Map Management). Falls back to Google's public "DEMO_MAP_ID"
# for local testing if left unset, but that ID has limited styling and is not for production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Places API (New) key, used server-side only by scripts/refresh-google-data.ts.
# Can be the same key as above if it has Places API (New) enabled, but keeping a
# separate server-only key avoids exposing Places quota to the browser.
GOOGLE_PLACES_API_KEY=

# Shared password gating /admin/*. Anyone with this password can edit brewery
# editorial content (ratings, comments, opening-hours overrides).
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Path to the SQLite database file. Defaults to ./data/brewery.db if unset.
DATABASE_PATH=./data/brewery.db
